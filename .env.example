# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube a git (está en .gitignore).

# Clave de API de Last.fm (se pide gratis en la sección de API de Last.fm)
LASTFM_API_KEY=

# Nombre con el que el pipeline se identifica ante MusicBrainz.
# MusicBrainz pide un User-Agent propio con un contacto: va la URL del repo
# (nunca un email personal). Formato: Nombre/versión ( contacto ).
MUSICBRAINZ_USER_AGENT=RedondosPipeline/0.1 ( https://github.com/alfanotomas/LosRedondos-en-datos )
